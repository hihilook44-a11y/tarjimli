[{"start": 0.0, "end": 7.16, "text": "يقولون إن الصراط قبل الحساب أشد حدة من السيف."}, {"start": 8.2, "end": 12.7, "text": "كل عبد سيُجتاز هذا الصراط يومًا ما."}, {"start": 13.76, "end": 20.18, "text": "ولكن هناك العديد من الطرق الدقيقة والصعبة"}, {"start": 20.48, "end": 25.56, "text": "هناك العديد من الطرق الوعرة والضيقة والصعبة."}, {"start": 32.26, "end": 36.1, "text": "يُبتلى البعض بمن يحبون."}, {"start": 36.74, "end": 47.14, "text": "البعض يُبتلى بالعثور على ما فقده، والبعض الآخر بفقدان ما عثر عليه مرة أخرى."}, {"start": 51.74, "end": 57.98, "text": "يمر الإنسان في هذه الدنيا بالعديد من الصراطات."}, {"start": 58.54, "end": 63.94, "text": "أحيانًا بالألم وأحيانًا بالحب."}, {"start": 64.74, "end": 69.7, "text": "وأحيانًا يُختبر بأكبر مخاوفه."}, {"start": 69.94, "end": 80.22, "text": "يعتقد الظالمون أنهم تركوا خطاياهم وراءهم،"}, {"start": 80.58, "end": 84.78, "text": "لكن الإيمان لا يترك صاحبه."}, {"start": 85.78, "end": 93.78, "text": "يمكن للإنسان أن يتجاوز الجميع، لكنه لا يستطيع الهروب من نفسه."}, {"start": 94.58, "end": 105.18, "text": "بعض الناس يأملون في الحصول على المساعدة من الفتوة، ويبحثون عن طريق الخلاص الذي أنشأوه بأنفسهم"}, {"start": 105.58, "end": 106.58, "text": "يبحث."}, {"start": 107.58, "end": 110.58, "text": "أما الضعيف فيُهزم أمام شهواته."}, {"start": 111.58, "end": 117.38, "text": "النفس تسير أمامه، والشهوة تتبعه."}, {"start": 118.18, "end": 126.18, "text": "مع كل خطوة يخطوها، يبتعد أكثر قليلًا عن الطريق الصحيح."}, {"start": 126.18, "end": 134.62, "text": "بعضهم يتعرّف على الألم قبل أن يتعرّف على خطيئته."}, {"start": 134.62, "end": 139.82, "text": "يمر من خلال المحن الكبيرة والصغيرة بقلبه الصغير."}, {"start": 139.82, "end": 145.82, "text": "وإذا كان صبورًا، فمن كان قد أصبح."}, {"start": 146.82, "end": 149.82, "text": "وما سيكون قد كان أيضًا."}, {"start": 149.82, "end": 153.82, "text": "نهاية شخص ما هي بداية شخص آخر."}, {"start": 154.82, "end": 160.82, "text": "ولا أحد يستطيع الوصول إلى وجهته دون عبور صراطه."}, {"start": 174.14, "end": 179.18, "text": "ستبقى بجانبه، أليس كذلك؟"}, {"start": 179.18, "end": 190.72, "text": "اعتقدت أنه سيتحول إلى رماد ويموت في ذلك المنزل."}, {"start": 190.72, "end": 197.62, "text": "تم إرسالها إلى دوندو. ظننت أنك تخلصت منها."}, {"start": 197.62, "end": 200.62, "text": "لكن انظري، انظري يا ليلى."}, {"start": 200.62, "end": 205.29, "text": "انظري، لقد خرجت من أجل تلك النار التي أشعلتها."}, {"start": 205.29, "end": 208.29, "text": "لقد ولدت من رمادي لأعاقبك يا ليلى."}, {"start": 210.29, "end": 212.29, "text": "سآخذك وأذهب بك إلى الجحيم."}, {"start": 213.29, "end": 214.29, "text": "لا تأتي."}, {"start": 214.29, "end": 215.29, "text": "لا تأتي."}, {"start": 215.29, "end": 216.29, "text": "لا تأتي."}, {"start": 217.29, "end": 218.29, "text": "توقفي."}, {"start": 218.29, "end": 219.29, "text": "توقفي."}, {"start": 220.29, "end": 223.29, "text": "ماذا ستعوضين أمي عن حياتها يا ليلى؟"}, {"start": 223.29, "end": 227.29, "text": "ماذا ستعوضين عن السنوات التي جعلتِ فيها شخصًا آخر يقوم بدور الأب، يا ليلى؟"}, {"start": 227.29, "end": 228.29, "text": "اتركني."}, {"start": 228.29, "end": 229.29, "text": "اتركني."}, {"start": 230.29, "end": 231.29, "text": "ماذا تفعلين؟"}, {"start": 231.29, "end": 235.29, "text": "أنتِ أحرقتينا حرقًا، وعندها شعرنا بالشفقة عليكِ."}, {"start": 236.29, "end": 238.29, "text": "وأنا أيضًا لن أشعر بالشفقة عليك يا ليلى."}, {"start": 238.29, "end": 242.29, "text": "لن أتركك حتى أجعلك تتذوقي كل الألم الذي سببتيه لي."}, {"start": 242.29, "end": 244.29, "text": "كفاك هذا الهراء."}, {"start": 244.29, "end": 246.29, "text": "لنعد إلى المنزل، وعندها سترين."}, {"start": 247.29, "end": 253.99, "text": "لقد بدأ ميرزا في البحث عني كثيرًا."}, {"start": 254.99, "end": 256.99, "text": "إنه يبحث عني في كل مكان الآن."}, {"start": 256.99, "end": 257.99, "text": "في كل مكان."}, {"start": 259.99, "end": 260.99, "text": "مرزا."}, {"start": 261.99, "end": 263.99, "text": "هذه هي الآلام التي أعرفها من نجاة ميرزا من ذلك الحادث."}, {"start": 264.99, "end": 267.88, "text": "أي حادث؟"}, {"start": 267.88, "end": 271.89, "text": "أي حادث؟"}, {"start": 272.89, "end": 273.89, "text": "أي حادث؟"}, {"start": 273.89, "end": 274.89, "text": "أي حادث؟"}, {"start": 274.89, "end": 275.89, "text": "ماذا كنت تقول؟"}, {"start": 275.89, "end": 279.17, "text": "لم يعد هناك من سيضعك في مكانك."}, {"start": 280.17, "end": 281.17, "text": "ماذا فعلتِ برأيك؟"}, {"start": 282.17, "end": 283.17, "text": "ماذا؟"}, {"start": 283.17, "end": 284.17, "text": "تعال."}, {"start": 284.17, "end": 285.17, "text": "تعال."}, {"start": 285.17, "end": 286.17, "text": "تعال."}, {"start": 286.17, "end": 287.17, "text": "تعال."}, {"start": 287.17, "end": 288.17, "text": "تعال."}, {"start": 288.17, "end": 289.17, "text": "تعال."}, {"start": 289.17, "end": 290.17, "text": "تعال."}, {"start": 290.17, "end": 291.17, "text": "من أنا بالنسبة لك؟"}, {"start": 291.17, "end": 292.17, "text": "حالي البائس."}, {"start": 292.17, "end": 294.17, "text": "كنت غنيًا عندما كنت هنا."}, {"start": 294.17, "end": 296.17, "text": "لكن لم يعد لديك أي دعم الآن."}, {"start": 300.27, "end": 302.27, "text": "انظري، خذي هذا معك يا ليلى."}, {"start": 302.27, "end": 303.27, "text": "انظري، خذي هذا معك."}, {"start": 304.27, "end": 306.27, "text": "وإلا فستحب الألم من شدة الألم."}, {"start": 307.27, "end": 345.87, "text": "مرزا."}, {"start": 346.87, "end": 347.87, "text": "هل أنت بخير؟"}, {"start": 347.87, "end": 348.87, "text": "أين ليلى؟"}, {"start": 348.87, "end": 349.87, "text": "أنا بخير، أنا بخير."}, {"start": 349.87, "end": 351.87, "text": "ليلى مع جدتها، وهي في أيدٍ أمينة."}, {"start": 352.87, "end": 353.87, "text": "كيف ذلك؟"}, {"start": 354.87, "end": 355.87, "text": "لقد تعطلت فراملها."}, {"start": 356.87, "end": 357.87, "text": "لقد حشرتنا على الطريق."}, {"start": 357.87, "end": 359.87, "text": "أجبرني على صنع غلاية."}, {"start": 359.87, "end": 361.87, "text": "لم تكن ليلى بجانبي عندما كنت على وشك الموت."}, {"start": 361.87, "end": 365.27, "text": "الوضيع."}, {"start": 366.27, "end": 370.57, "text": "كأنني سأعثر عليه."}, {"start": 370.57, "end": 372.57, "text": "سأجد هذا الوغد الحقير."}, {"start": 373.57, "end": 374.57, "text": "ستجده يا أخي."}, {"start": 375.57, "end": 376.57, "text": "هل اتصلت الشرطة؟"}, {"start": 376.57, "end": 377.57, "text": "هل حشرنا في السيارة؟"}, {"start": 377.57, "end": 378.57, "text": "أعطيت درسًا لمدة دقيقة واحدة."}, {"start": 379.57, "end": 380.57, "text": "هيا."}, {"start": 380.57, "end": 381.57, "text": "كثيرًا."}, {"start": 382.57, "end": 383.57, "text": "هيا، أسرعي، دعيني أصورك بسرعة."}, {"start": 384.57, "end": 385.57, "text": "هيا امشِ."}, {"start": 385.57, "end": 401.1, "text": "كيف تمكن من تصوير هذا؟"}, {"start": 402.1, "end": 403.1, "text": "الحاج صور كل شيء."}, {"start": 404.1, "end": 426.0, "text": "هينا."}, {"start": 427.0, "end": 429.0, "text": "يمكنك الآن الاستيقاظ من النوم يا حماتي."}, {"start": 429.0, "end": 430.0, "text": "الحماة."}, {"start": 430.0, "end": 435.1, "text": "أنت تريدين مني."}, {"start": 436.1, "end": 437.1, "text": "من أجل الأيام القادمة."}, {"start": 438.1, "end": 439.1, "text": "تأمين على الحياة مرة أخرى."}, {"start": 441.1, "end": 442.1, "text": "أنت في أماني."}, {"start": 443.1, "end": 445.1, "text": "روسلان ألقى طعمًا، التأمين."}, {"start": 446.1, "end": 448.54, "text": "ماذا تريد مني برأيك؟"}, {"start": 448.54, "end": 454.32, "text": "ليلى في يد ناصم."}, {"start": 455.32, "end": 456.32, "text": "واحد."}, {"start": 456.32, "end": 458.66, "text": "كيف حصلتِ عليه أصلاً؟"}, {"start": 459.66, "end": 460.66, "text": "هل تعرفين شيئًا واحدًا فقط؟"}, {"start": 461.66, "end": 462.66, "text": "أم أنك."}, {"start": 462.66, "end": 466.01, "text": "أم أنكم فعلتم شيئًا لابني؟"}, {"start": 466.01, "end": 468.01, "text": "لقد وضع ابني في ورطة مختلفة."}, {"start": 468.01, "end": 471.41, "text": "للأسف."}, {"start": 472.41, "end": 473.41, "text": "إنه على قيد الحياة."}, {"start": 473.41, "end": 474.41, "text": "إنه على قيد الحياة."}, {"start": 474.41, "end": 480.09, "text": "الله يعاقبك."}, {"start": 480.09, "end": 481.09, "text": "اغرب عن وجهي من هنا."}, {"start": 481.09, "end": 482.09, "text": "اغرب عن وجهي."}, {"start": 483.09, "end": 485.09, "text": "هل أنت جملة \"آمين\"؟"}, {"start": 485.09, "end": 486.09, "text": "هل أنت جملة؟"}, {"start": 487.09, "end": 488.09, "text": "الآن أطلق سراحي."}, {"start": 489.09, "end": 493.09, "text": "كيف يمكنها أن تخرج من عند الموظف وتذهب إلى ليلى ثم تذهب إلى حلب سالمة؟"}, {"start": 494.09, "end": 495.09, "text": "سوف ترسم له الطريق."}, {"start": 496.09, "end": 497.09, "text": "هل أنت مجنون؟"}, {"start": 497.09, "end": 498.09, "text": "مينزا عرفت هذا أيضًا، أنا هالك."}, {"start": 498.09, "end": 500.09, "text": "ستلقي بكل اللوم علينا."}, {"start": 500.09, "end": 501.09, "text": "لا، لا أستطيع."}, {"start": 501.09, "end": 503.09, "text": "والله الأمر عائد لك يا حماتي."}, {"start": 504.09, "end": 506.09, "text": "ستجدين نفسك في طريقك إلى حلب."}, {"start": 506.09, "end": 510.09, "text": "أو سنخبر الجميع كيف قتل زوجك."}, {"start": 511.09, "end": 512.09, "text": "اذهبي أنت."}, {"start": 512.09, "end": 525.95, "text": "بيتم!"}, {"start": 525.95, "end": 531.29, "text": "إذا فعلت شيئًا كهذا مرة أخرى، فسأجدك، وإذا علمت زوجتك."}, {"start": 531.29, "end": 543.27, "text": "متى سيخرجنا من هنا؟"}, {"start": 543.27, "end": 546.27, "text": "في غضون ساعة على أبعد تقدير، سيتم إرسال سيارة لإخراجكم من هناك."}, {"start": 547.27, "end": 549.27, "text": "يا ولدي، أي ساعة هذه؟"}, {"start": 549.27, "end": 552.27, "text": "في ذلك الوقت سيكون المكان قد أصبح مزدحمًا، وليس لدينا وقت."}, {"start": 552.27, "end": 554.27, "text": "يا ولدي، لماذا تتذمر مني؟"}, {"start": 554.27, "end": 556.27, "text": "يا إلهي، إذن الأمر يتعلق بالسيارة التي تحتك وبالصحافة."}, {"start": 557.27, "end": 560.67, "text": "السيارة مسروقة."}, {"start": 560.67, "end": 562.67, "text": "سيوقفوننا قبل أن نصل إلى الطريق السريع."}, {"start": 562.67, "end": 564.67, "text": "انتظر لحظة، لقد علقنا يا رجل."}, {"start": 564.67, "end": 565.67, "text": "ألم تقل أنك ستقوم بالترتيب."}, {"start": 565.67, "end": 568.67, "text": "يا رجل، ليس يا رجل، من أين لي أن أعرف أنك ستأخذها بهذه السرعة؟"}, {"start": 568.67, "end": 570.67, "text": "كان من المفترض أن ترتب الأمر أولاً."}, {"start": 570.67, "end": 572.67, "text": "هكذا حدث التمديد."}, {"start": 572.67, "end": 573.67, "text": "تم ضبطه على السيارة."}, {"start": 573.67, "end": 575.67, "text": "على أي حال، حسنًا، حسنًا."}, {"start": 575.67, "end": 577.67, "text": "حسنًا، الآن لدي بعض الأشياء لأقوم بها."}, {"start": 577.67, "end": 579.67, "text": "سأقوم بإعدادها نيئة."}, {"start": 579.67, "end": 580.67, "text": "توقف يا أبي، توقف."}, {"start": 580.67, "end": 581.67, "text": "هيا."}, {"start": 581.67, "end": 586.71, "text": "ماذا تفعل عندما تفعل هكذا، هل تمشي؟"}, {"start": 586.71, "end": 587.71, "text": "إنها كارثة."}, {"start": 587.71, "end": 588.71, "text": "غطاء رأسك يطير."}, {"start": 588.71, "end": 596.34, "text": "أين ذهب الآن؟"}, {"start": 596.34, "end": 604.29, "text": "انظر، هل رأيت؟"}, {"start": 604.29, "end": 612.97, "text": "الشيء المخيف."}, {"start": 612.97, "end": 615.82, "text": "أنت تكذب."}, {"start": 615.82, "end": 616.82, "text": "ميرزا على قيد الحياة."}, {"start": 616.82, "end": 620.2, "text": "أقول لك إنه مات."}, {"start": 620.2, "end": 621.2, "text": "مات، مات."}, {"start": 621.2, "end": 623.2, "text": "كنت تقول لي شيئًا من أجل التغطية."}, {"start": 623.2, "end": 624.2, "text": "نفس الأكاذيب."}, {"start": 624.2, "end": 626.2, "text": "كنت تخيفني هكذا."}, {"start": 626.2, "end": 628.2, "text": "أنا لا أصدقك."}, {"start": 628.2, "end": 630.2, "text": "ميرزا على قيد الحياة."}, {"start": 630.2, "end": 632.2, "text": "لن يخرجك من هذه المدينة."}, {"start": 632.2, "end": 633.2, "text": "ليلة واحدة."}, {"start": 633.2, "end": 634.2, "text": "ابتعدي."}, {"start": 634.2, "end": 635.2, "text": "من الأفضل أن أموت."}, {"start": 635.2, "end": 652.08, "text": "يا ابنتي، لن أتركك وأذهب إلى أي مكان."}, {"start": 652.08, "end": 656.29, "text": "حسنًا، من سيوقفني؟"}, {"start": 656.29, "end": 665.3, "text": "حماك الذي يحبك كثيرًا."}, {"start": 665.3, "end": 668.98, "text": "ما هذا؟"}, {"start": 668.98, "end": 669.98, "text": "ما هذا؟"}, {"start": 669.98, "end": 670.98, "text": "لن تعرف."}, {"start": 670.98, "end": 673.98, "text": "مع حماتك التي تحبك كثيرًا."}, {"start": 673.98, "end": 675.98, "text": "أم هو والدك المعاق."}, {"start": 675.98, "end": 680.19, "text": "لماذا لا تفهمين يا ليلى؟"}, {"start": 680.19, "end": 681.19, "text": "انتهت اللعبة."}, {"start": 681.19, "end": 685.85, "text": "سنعود إلى هالة."}, {"start": 685.85, "end": 686.85, "text": "السيارة هنا اليوم."}, {"start": 686.85, "end": 734.68, "text": "يا ميرزا، هراج تركها هنا."}, {"start": 734.68, "end": 736.68, "text": "وهو على متن أناديا."}, {"start": 736.68, "end": 738.68, "text": "بدأ كل شيء في هذه المنطقة."}, {"start": 738.68, "end": 740.68, "text": "بدأ، بدأ بالفعل."}, {"start": 740.68, "end": 743.68, "text": "لا يعتبر ميس الابتسامة كدليل كافٍ."}, {"start": 743.68, "end": 745.68, "text": "لأنها هي من ابتكرت كل هذا."}, {"start": 745.68, "end": 747.68, "text": "ربما يكون قد غير مساره."}, {"start": 747.68, "end": 750.84, "text": "... لن نتابع هذه الأماكن في أقرب وقت ممكن."}, {"start": 751.24, "end": 752.8, "text": "هل نضع المخرج من المدينة؟"}, {"start": 753.36, "end": 753.96, "text": "حاضر."}, {"start": 756.93, "end": 758.85, "text": "هل تعرف كيف كان الوضع في أيام منيش كاليان والشرطة؟"}, {"start": 759.17, "end": 759.97, "text": "بالطبع، أعطني إياها على الفور."}, {"start": 760.77, "end": 762.97, "text": "لا يمكن أن يكون قد غادر المدينة في وقت قصير جدًا، أليس كذلك؟"}, {"start": 763.41, "end": 764.13, "text": "مستحيل."}, {"start": 764.61, "end": 777.46, "text": "حاز"}, {"start": 777.86, "end": 778.94, "text": "أنا ليس لدي أي شيء."}, {"start": 779.3, "end": 781.34, "text": "يا صاح، لا قدر الله، قد يكون هناك نزيف أو شيء من هذا القبيل."}, {"start": 781.62, "end": 782.58, "text": "هل أنت بخير؟"}, {"start": 782.98, "end": 784.74, "text": "لن أذهب إلى أي مكان حتى أجد الدب."}, {"start": 794.79, "end": 796.63, "text": "لا، سأصاب بالجنون، الهاتف مشغول."}, {"start": 799.5, "end": 801.02, "text": "يا مغمور، يا إكر، أرجوكِ اهدئي قليلاً."}, {"start": 801.58, "end": 802.7, "text": "نحن ذاهبون بالفعل، دعيني أرى."}, {"start": 803.26, "end": 805.14, "text": "الآن نحن في أنطاكيا، وفي مكان لا يعرفه، من فضلك."}, {"start": 805.38, "end": 806.9, "text": "وكيف يمكنني أن أهدأ يا يامان؟"}, {"start": 807.34, "end": 809.7, "text": "أصدقاء فيصل مثل فيصل."}, {"start": 810.42, "end": 812.62, "text": "أوف، هذا الرجل الذي يتصل به هو شخص خاص."}, {"start": 813.9, "end": 816.38, "text": "يا رب ساعدني، سأوقع ابني في مشكلة."}, {"start": 817.46, "end": 818.62, "text": "يا رب ساعدني."}, {"start": 824.51, "end": 827.35, "text": "أوف، ذلك الفاتح، أوف."}, {"start": 827.67, "end": 841.52, "text": "هل تريد أن تجعلني مجنونًا؟"}, {"start": 842.32, "end": 843.6, "text": "سأذهب لأحضر المال من الأسفل."}, {"start": 844.16, "end": 845.08, "text": "اطلب من عمي."}, {"start": 845.28, "end": 846.8, "text": "لا تغضبي مني، المال سيأتي إليك."}, {"start": 846.92, "end": 847.52, "text": "آتيش."}, {"start": 847.6, "end": 849.32, "text": "لا تتكلم بهذا الهراء من فضلك."}, {"start": 850.0, "end": 852.92, "text": "أمي والعائلة قادمون الآن للعثور عليك في أنطاكيا."}, {"start": 856.55, "end": 857.71, "text": "هل هم قادمون إلى أنطاكيا؟"}, {"start": 859.86, "end": 860.7, "text": "إنهم قادمون."}, {"start": 863.1, "end": 864.34, "text": "أنا لم أذهب إلى أنطاكيا."}, {"start": 868.19, "end": 869.23, "text": "لقد كذبت عليكم."}, {"start": 871.6, "end": 874.92, "text": "ولكن لماذا تكذب بشأن مثل هذا الموضوع؟"}, {"start": 877.22, "end": 878.54, "text": "لماذا أفعل ذلك؟"}, {"start": 880.5, "end": 882.22, "text": "لو كان هنا لكان سيمنعك."}, {"start": 882.66, "end": 883.78, "text": "وهو سيوقفني أيضًا."}, {"start": 884.06, "end": 885.26, "text": "ليوقفوني بالفعل."}, {"start": 888.52, "end": 890.08, "text": "لن تخبر أمي بأي شيء، أليس كذلك؟"}, {"start": 890.28, "end": 891.04, "text": "دعهم يذهبون."}, {"start": 891.8, "end": 893.44, "text": "يا تيش، هل أنت أحمق؟"}]